CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LIVE_INGESTION_API_KEY=replace-with-a-strong-live-source-key
LIVE_SIMULATOR_RATE=2
LIVE_SIMULATOR_MAX_EVENTS=0
